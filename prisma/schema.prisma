datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Kullanıcı Modeli (Auth0 kullanıcısı ile eşleşir)
model User {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  auth0Id   String   @unique // Auth0'dan gelen benzersiz kullanıcı ID'si (sub)
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  resumes    ResumeAnalysis[]
  interviews InterviewSession[]
}

// CV & İş İlanı Analizi Modeli
model ResumeAnalysis {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  jobTitle       String   // Hedef İş Unvanı (Örn: Frontend Developer)
  jobDescription String   // İş İlanı Metni
  resumeText     String   // Kullanıcının CV Metni
  
  matchScore     Int      // AI Eşleşme Skoru (0-100)
  feedback       String   // Genel AI Geribildirimi
  missingSkills  String[] // Eksik Beceriler Listesi
  strengths      String[] // Güçlü Yönler Listesi
  suggestions    String[] // İyileştirme Önerileri

  createdAt DateTime @default(now())
}

// AI Mülakat Simülasyonu Modeli
model InterviewSession {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  roleTitle String   // Mülakat Yapılan Pozisyon
  messages  Json     // Mülakat Sohbet Geçmişi (AI SDK Chat formatı)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}